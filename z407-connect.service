[Unit]
Description=Keep the Logi Z407 speakers connected over Bluetooth
After=wireplumber.service pipewire-pulse.service
Wants=wireplumber.service

[Service]
Type=exec
Environment=Z407_MAC=AA:BB:CC:DD:EE:FF
ExecStart=%h/.local/bin/z407-connect
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
